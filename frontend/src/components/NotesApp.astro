---
import NoteList from './NoteList.astro';
import NoteEditor from './NoteEditor.astro';
---

<div id="notes-app" class="app-root" data-primary="#1e88e5" data-secondary="#43a047" data-accent="#fdd835">
  <header class="app-header">
    <h1 class="app-title">
      <span class="icon-notes">&#9998;</span> NotesApp
    </h1>
    <button id="new-note-btn" class="primary-btn" type="button">+ New Note</button>
  </header>
  <main class="notes-main-grid">
    <section class="notes-list-section">
      <h2 class="section-title">Your Notes</h2>
      <div id="notes-list"></div>
    </section>
    <section class="notes-editor-section" id="editor-section">
      <div id="editor-or-preview"></div>
    </section>
  </main>
</div>

<script type="module" is:inline>
const storageKey = "notes-app-data-v1";
function loadNotes() {
  try {
    const notes = JSON.parse(localStorage.getItem(storageKey) || "[]");
    if (Array.isArray(notes)) return notes;
    return [];
  } catch { return []; }
}
function saveNotes(notes) {
  localStorage.setItem(storageKey, JSON.stringify(notes));
}

let notes = loadNotes();
let activeId = notes[0] ? notes[0].id : null;
let isEditing = false;
let editorNote = null;

const listEl = document.getElementById('notes-list');
const previewEl = document.getElementById('editor-or-preview');
const sectionEl = document.getElementById('editor-section');
const newNoteBtn = document.getElementById('new-note-btn');

function renderList() {
  let html = "";
  if (notes.length === 0) {
    html = '<ul class="note-list"><li class="empty">No notes yet.</li></ul>';
  } else {
    html = `<ul class="note-list">` + notes.map(n => `
      <li class="note-list-item${n.id === activeId ? ' active' : ''}" tabindex="0" data-id="${n.id}">
        <span class="note-title">${n.title ? escapeHTML(n.title) : "Untitled"}</span>
        <button class="delete-btn" aria-label="Delete note" data-id="${n.id}">&#10006;</button>
      </li>
    `).join("") + '</ul>';
  }
  listEl.innerHTML = html;
  // Setup events
  for (const item of listEl.querySelectorAll('.note-list-item')) {
    item.onclick = () => selectNote(item.getAttribute("data-id"));
  }
  for (const del of listEl.querySelectorAll('.delete-btn')) {
    del.onclick = (e) => {
      e.stopPropagation();
      deleteNote(del.getAttribute("data-id"));
    };
  }
}
function renderPreview() {
  const note = notes.find(n=>n.id===activeId);
  if (!note) {
    previewEl.innerHTML = `<div class="note-preview-empty">Select a note or create one to get started.</div>`;
    return;
  }
  previewEl.innerHTML = `
    <div class="note-preview">
      <div class="note-preview-title">
        <h3>${note.title ? escapeHTML(note.title) : "Untitled"}</h3>
        <button class="edit-btn" title="Edit Note" id="edit-note-btn">&#9998; Edit</button>
      </div>
      <pre class="note-body" tabindex="0">${escapeHTML(note.content)}</pre>
    </div>
  `;
  document.getElementById('edit-note-btn').onclick = () => editNote();
}
function renderEditor() {
  // If editorNote is null, treat as add new.
  const editingNote = editorNote || {title:"", content:""};
  previewEl.innerHTML = `
    <form class="note-editor" id="note-edit-form">
      <input class="note-title-input" type="text" required placeholder="Title" maxlength="80" value="${escapeHTML(editingNote.title || "")}" aria-label="Note title" autofocus />
      <textarea class="note-content-input" rows="12" placeholder="Write your note here..." aria-label="Note content">${editingNote.content ? escapeHTML(editingNote.content) : ""}</textarea>
      <div class="editor-actions">
        <button type="submit" class="save-btn">${editingNote.id ? "Save Changes" : "Create Note"}</button>
        <button type="button" id="cancel-edit-btn" class="cancel-btn">Cancel</button>
      </div>
    </form>
  `;
  document.getElementById('note-edit-form').onsubmit = (e) => {
    e.preventDefault();
    const form = e.target;
    const title = form.querySelector('.note-title-input').value.trim();
    const content = form.querySelector('.note-content-input').value.trim();
    saveNote({...editingNote, title, content});
  };
  document.getElementById('cancel-edit-btn').onclick = () => cancelEdit();
}

function syncUI() {
  renderList();
  if (isEditing) renderEditor();
  else renderPreview();
}
function selectNote(id) {
  activeId = id;
  isEditing = false;
  editorNote = null;
  syncUI();
}
function addNote() {
  isEditing = true;
  editorNote = { title: "", content: "" };
  syncUI();
}
function editNote() {
  const note = notes.find(n => n.id === activeId);
  if (!note) return;
  isEditing = true;
  editorNote = {...note};
  syncUI();
}
function deleteNote(id) {
  notes = notes.filter(n => n.id !== id);
  saveNotes(notes);
  if (activeId === id) {
    activeId = notes.length ? notes[0].id : null;
    isEditing = false;
    editorNote = null;
  }
  syncUI();
}
function saveNote(newNote) {
  let updatedNotes;
  if (newNote.id) {
    updatedNotes = notes.map(n =>
      n.id === newNote.id ? { ...n, ...newNote, updated: Date.now() } : n
    );
  } else {
    const id = String(Date.now()) + String(Math.floor(Math.random() * 1e10));
    updatedNotes = [
      { ...newNote, id, updated: Date.now() },
      ...notes,
    ];
    activeId = id;
  }
  notes = updatedNotes;
  saveNotes(notes);
  isEditing = false;
  editorNote = null;
  syncUI();
}
function cancelEdit() {
  isEditing = false;
  editorNote = null;
  syncUI();
}
function escapeHTML(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
newNoteBtn.onclick = addNote;
window.addEventListener("DOMContentLoaded", syncUI);
</script>

<style>
/* -- App-wide improvements -- */
.app-root {
	min-height: 100vh;
	padding-top: 1.5rem;
	box-sizing: border-box;
	background: linear-gradient(135deg, var(--bg-color), #f7fbff 90%);
}
.app-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 2.1rem 1.3rem 1.25rem 1.8rem;
	border-bottom: 1.5px solid var(--border-color);
	background: rgba(255,255,255,0.85);
	backdrop-filter: blur(1.2px);
	box-shadow: 0 2px 14px -7px var(--shadow-color);
	border-radius: 15px 15px 0 0;
	margin-bottom: 0.2rem;
}
.app-title {
	margin: 0;
	font-size: 2.2rem;
	font-weight: 800;
	letter-spacing: -1px;
	color: var(--primary);
	display: flex;
	align-items: center;
	gap: 0.6em;
	user-select: none;
	text-shadow: 0 3px 12px #e9f1fc4d;
}
.icon-notes {
	font-size: 1.3em;
	color: var(--accent);
	vertical-align: middle;
}

.primary-btn {
	background: linear-gradient(90deg, var(--primary) 87%, var(--accent));
	color: #fff;
	border: none;
	border-radius: 2.2em;
	padding: 12px 32px;
	font-size: 1.09em;
	font-weight: 600;
	cursor: pointer;
	transition: background 0.19s, box-shadow 0.16s;
	outline: none;
	box-shadow: 0 2px 12px -2px var(--shadow-color);
	letter-spacing: 0.02em;
}
.primary-btn:hover, .primary-btn:focus {
	background: linear-gradient(100deg, #1565c0 78%, #fde57d);
	box-shadow: 0 3px 16px 0 var(--shadow-hover-color);
}

.notes-main-grid {
	display: grid;
	grid-template-columns: 340px 1fr;
	gap: 2.7rem;
	max-width: 100vw;
	width: 1140px;
	margin: 2.2rem auto 0 auto;
	padding: 0 1.75rem 2.2rem 1.3rem;
}
.notes-list-section {
	min-width: 270px;
	padding-right: 0.2em;
}
.notes-editor-section {
	background: var(--card-bg);
	border-radius: 18px;
	box-shadow: 0 4px 22px var(--shadow-color);
	padding: 1.8rem 2.15rem 1.9rem 2.0rem;
	min-width: 0;
	min-height: 230px;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	align-items: stretch;
	transition: box-shadow 0.15s;
}
.notes-editor-section:focus-within {
	box-shadow: 0 8px 32px var(--shadow-hover-color);
}

.section-title {
	font-size: 1.09em;
	color: var(--secondary);
	margin: 0 0 1.15em 0.12em;
	letter-spacing: 1.5px;
	text-transform: uppercase;
	font-weight: 700;
	opacity: 0.98;
}

.note-preview {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.note-preview-title {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	margin-bottom: 0.8em;
	gap: 1.1em;
}
.note-preview-title h3 {
	font-size: 1.38em;
	color: var(--accent);
	margin: 0;
	padding: 0;
	font-weight: 700;
	word-break: break-word;
	letter-spacing: 0.01em;
	line-height: 1.14;
}

.edit-btn {
	color: var(--secondary);
	background: rgba(67, 160, 71, 0.09);
	border: none;
	border-radius: 7px;
	font-weight: 600;
	padding: 7px 19px 7px 17px;
	font-size: .94em;
	cursor: pointer;
	margin-left: 9px;
	transition: background 0.14s, color 0.16s, box-shadow 0.18s;
	box-shadow: 0 1px 7px 0 var(--shadow-color);
	display: flex;
	align-items: center;
	gap: 0.44em;
}
.edit-btn:hover, .edit-btn:focus {
	background: var(--secondary);
	color: #fff;
	box-shadow: 0 2px 9px 0 var(--shadow-hover-color);
}

.note-body {
	white-space: pre-wrap;
	font-size: 1.09em;
	color: var(--text-secondary);
	background: #fcf9e6;
	border-radius: 11px;
	padding: 1.45em 1.15em 1.3em 1.4em;
	margin: 0 0 0.2em 0;
	min-height: 80px;
	max-height: 33vh;
	overflow-y: auto;
	box-shadow: 0 1.5px 6px 0 var(--shadow-color);
	font-family: inherit;
	border: 1.1px solid var(--border-color);
	transition: border 0.14s;
}
.note-body:focus {
	border: 1.35px solid var(--accent);
	background: #fefaeb;
}

.note-preview-empty {
	color: var(--text-secondary);
	opacity: 0.68;
	text-align: center;
	font-size: 1.1em;
	padding: 2.7em 0 2.72em 0;
	letter-spacing: 1.2px;
	background: none;
}

@media (max-width: 1100px) {
	.notes-main-grid {
		width: 100vw;
		grid-template-columns: 1fr;
		gap: 1.3rem;
		padding: 0 0.3rem 1rem 0.3rem;
	}
	.notes-list-section, .notes-editor-section {
		width: 100%;
		max-width: 754px;
		margin: 0 auto;
	}
	.notes-editor-section {
		border-radius: 13px;
		padding: 1.18rem 0.75rem 1.6rem 0.9rem;
	}
}
@media (max-width: 800px) {
	.app-root {
		padding-top: 0.1rem;
	}
	.notes-main-grid {
		grid-template-columns: 1fr;
		gap: 1.9rem;
		width: 100%;
		min-width: 0;
		margin: 0.8rem auto 0 auto;
		padding: 0 0.13rem 0.8rem 0.13rem;
	}
	.notes-list-section, .notes-editor-section {
		width: 100%;
		min-width: 0;
		max-width: 660px;
		margin: 0 auto;
	}
	.notes-editor-section {
		border-radius: 11px;
		padding: 0.6rem 0.58rem 1.2rem 0.65rem;
	}
}
@media (max-width: 570px) {
	.app-header, .notes-main-grid {
		padding-left: 0.08rem;
		padding-right: 0.08rem;
	}
	.app-title {
		font-size: 1.13em;
	}
	.primary-btn {
		padding: 9px 15px;
	}
	.section-title {
		font-size: 0.92em;
	}
}
</style>
