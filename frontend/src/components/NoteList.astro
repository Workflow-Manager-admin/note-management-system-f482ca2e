---
const { notes = [], activeId = '', onSelect, onDelete } = Astro.props;
---

<ul class="note-list">
  {notes.length === 0 ? (
    <li class="empty">No notes yet.</li>
  ) : (
    notes.map(note => (
      <li
        class={['note-list-item', note.id === activeId ? 'active' : ''].join(' ')}
        tabindex="0"
        onClick={() => onSelect(note.id)}
        aria-selected={note.id === activeId}
      >
        <span class="note-title">{note.title || "Untitled"}</span>
        <button
          class="delete-btn"
          aria-label="Delete note"
          onClick={e => { e.stopPropagation(); onDelete(note.id); }}
        >&#10006;</button>
      </li>
    ))
  )}
</ul>

<style>
.note-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.note-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 1rem;
  margin-bottom: 0.5rem;
  border-radius: 8px;
  background: var(--card-bg);
  cursor: pointer;
  border: 1px solid var(--border-color);
  transition: background 0.2s, border-color 0.2s;
}

.note-list-item.active, .note-list-item:focus {
  outline: none;
  border: 1.5px solid #1e88e5;
  background: #e3f2fd;
}

.note-list-item .note-title {
  font-weight: 500;
  font-size: 1rem;
  color: var(--text-color);
  flex: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.delete-btn {
  margin-left: 12px;
  background: none;
  border: none;
  font-size: 1.1rem;
  color: #e53935;
  cursor: pointer;
  padding: 2px 5px;
  border-radius: 4px;
  transition: background 0.15s;
}

.delete-btn:hover {
  background: #ffebee;
}

.empty {
  opacity: 0.6;
  padding: 1.2em 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 1rem;
}
</style>
