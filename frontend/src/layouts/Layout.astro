---
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<ThemeToggle />
		<slot />
	</body>
</html>

<style>
	:root {
		/* Light theme variables and accent system */
		--primary: #1e88e5;
		--primary-light: #e3f2fd;
		--secondary: #43a047;
		--accent: #fdd835;

		--bg-color: #fcfcfd;
		--text-color: #181f27;
		--text-secondary: #5b6472;
		--border-color: rgba(34, 56, 132, 0.10);
		--card-bg: #fff;
		--card-hover-bg: #f8fafc;
		--shadow-color: rgba(30, 136, 229, 0.08);
		--shadow-hover-color: rgba(30, 136, 229, 0.16);
	}

	body.dark-theme {
		/* Dark theme variables */
		--primary: #1e88e5;
		--primary-light: #223355;
		--secondary: #43a047;
		--accent: #fdd835;

		--bg-color: #131b24;
		--text-color: #f7fafd;
		--text-secondary: #aab7cf;
		--border-color: rgba(200, 230, 255, 0.12);
		--card-bg: #202b39;
		--card-hover-bg: #27394d;
		--shadow-color: rgba(50, 130, 255, 0.20);
		--shadow-hover-color: rgba(65, 167, 231, 0.4);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Inter', 'Helvetica Neue', Arial, system-ui, sans-serif;
		font-size: 16px;
		font-smooth: always;
		-webkit-font-smoothing: antialiased;
		background-color: var(--bg-color);
		color: var(--text-color);
		transition: background-color 0.25s, color 0.20s;
	}

	::-webkit-scrollbar {
		width: 10px;
		background: var(--bg-color);
	}
	::-webkit-scrollbar-thumb {
		background: linear-gradient(120deg, var(--primary) 58%, var(--secondary) 100%);
		border-radius: 7px;
		min-height: 75px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: linear-gradient(105deg, var(--primary), var(--accent));
	}
	::-webkit-scrollbar-corner {
		background: var(--bg-color);
	}
	/* Firefox custom scrollbar */
	* {
		scrollbar-width: thin;
		scrollbar-color: var(--primary) var(--bg-color);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1.5px;
		transition: outline 0.16s;
	}
</style>
